# 1 — использовать mock-сценарий без LLM-ключей, удобно для локального dry-run.
USE_MOCK_LLM=1

# 0 — не публиковать в Instagram, только собрать MP4 в out/.
PUBLISH=0

# Gemini 2.5 Flash: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq fallback Llama 3.3 70B: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Pexels Video API: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Instagram Graph API: Meta Developers / Instagram API with Instagram Login.
IG_USER_ID=your_instagram_business_or_creator_user_id
IG_ACCESS_TOKEN=your_long_lived_instagram_access_token

# GitHub Actions создаёт GITHUB_TOKEN автоматически. Локально можно подставить PAT с contents:write.
GITHUB_TOKEN=your_github_token_here
GITHUB_REPOSITORY=owner/repo

# Настройки контента.
NICHE=удивительные факты
TTS_VOICE=ru-RU-DmitryNeural
USE_MUSIC=1
# MUSIC_PATH=/absolute/path/to/cc0-or-cc-by-background-track.mp3
